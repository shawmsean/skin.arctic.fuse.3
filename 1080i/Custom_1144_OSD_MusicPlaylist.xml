<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1144">
    <zorder>0</zorder>
    <defaultcontrol always="true">7000</defaultcontrol>
    <onload>CancelAlarm(osd_timeout,true)</onload>
    <onload>CancelAlarm(musicosd_showlyrics,true)</onload>
    <onload>RunPlugin(plugin://$VAR[Action_MusicOSD_CommentPlugin]/playlist_focus_current/)</onload>
    <include>Animation_OSD_Dialog_WindowChange</include>
    <controls>

        <control type="image">
            <visible>!Skin.HasSetting(MusicOSD.CommentsDimBg)</visible>
            <texture colordiffuse="B2000000">common/white.png</texture>
        </control>

        <control type="group">
            <include>Animation_OSD_Dialog_VisibleChange</include>
            <control type="group">
                <include>OSD_Info_Dimensions</include>

                <include content="OSD_View_Line">
                    <param name="label">$LOCALIZE[559]</param>
                </include>

                <include content="List_Square_Row">
                    <param name="orientation">horizontal</param>
                    <param name="control">fixedlist</param>
                    <param name="id">7000</param>
                    <include content="Object_ContentDynamic">
                        <param name="content">playlistmusic://</param>
                    </include>
                    <include>OSD_List_Dimensions</include>
                    <onclick>SetProperty(nc_play_offset,$INFO[Container(7000).CurrentItem],Home)</onclick>
                    <onclick>RunPlugin(plugin://$VAR[Action_MusicOSD_CommentPlugin]/play_playlist_offset/)</onclick>
                    <onup condition="!Skin.HasSetting(MusicOSD.OnDown.Disable1142)">SetProperty(bili_comment_content_url,plugin://$VAR[Action_MusicOSD_CommentPlugin]/current_song_comments/0,10000)</onup>
                    <onup condition="!Skin.HasSetting(MusicOSD.OnDown.Disable1142)">Close</onup>
                    <onup condition="!Skin.HasSetting(MusicOSD.OnDown.Disable1142)">AlarmClock(musicosd_nav,ActivateWindow(1142),00:00,silent)</onup>
                    <onup>Close</onup>
                    <ondown>Close</ondown>
                    <ondown>AlarmClock(musicosd_nav,ActivateWindow($VAR[Action_MusicOSD_1144_OnDown]),00:00,silent)</ondown>
                    <onfocus>SetProperty(TMDbHelper.WidgetContainer,7000,1144)</onfocus>
                    <onunfocus>ClearProperty(TMDbHelper.WidgetContainer,1144)</onunfocus>
                    <include content="Animation_ConditionalFade">
                        <param name="condition">Container(7000).IsUpdating</param>
                    </include>
                </include>

                <include content="OSD_Info_Tray">
                    <param name="icon">$VAR[Image_OSD_7000_Poster]</param>
                    <param name="role">$VAR[Label_OSD_7000_Title]</param>
                    <param name="name">$VAR[Label_OSD_7000_SubLabel]</param>
                    <param name="text">$INFO[Container(7000).ListItem..Plot]</param>
                </include>

                <include content="Widget_Busy">
                    <param name="label">$PARAM[label]</param>
                    <param name="visible">Container(7000).IsUpdating</param>
                    <param name="include">List_Square_Row</param>
                    <left>view_pad</left>
                    <top>-150</top>
                </include>

            </control>
        </control>
    </controls>
</window>
