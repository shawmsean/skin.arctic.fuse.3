<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1154">
    <defaultcontrol always="true">6209</defaultcontrol>
    <onload>CancelAlarm(osd_timeout,true)</onload>
    <controls>

        <control type="group">
            <include>OSD_HideControls</include>
            <visible>!Window.IsVisible(DialogSlider.xml)</visible>

            <control type="group">
                <include content="Animation_SlideIn_Dialog">
                    <param name="posy">48</param>
                </include>

                <animation effect="fade" start="100" end="0" condition="Integer.IsEqual(Container(6209).NumItems,0)">Conditional</animation>

                <right>-40</right>
                <width>720</width>
                <bottom>220</bottom>
                <height>760</height>

                <control type="group">
                    <animation effect="slide" start="0" end="0,80" condition="Integer.IsEqual(Container(6209).NumItems,6)">Conditional</animation>
                    <animation effect="slide" start="0" end="0,160" condition="Integer.IsEqual(Container(6209).NumItems,5)">Conditional</animation>
                    <animation effect="slide" start="0" end="0,240" condition="Integer.IsEqual(Container(6209).NumItems,4)">Conditional</animation>
                    <animation effect="slide" start="0" end="0,320" condition="Integer.IsEqual(Container(6209).NumItems,3)">Conditional</animation>
                    <animation effect="slide" start="0" end="0,400" condition="Integer.IsEqual(Container(6209).NumItems,2)">Conditional</animation>
                    <animation effect="slide" start="0" end="0,480" condition="Integer.IsLess(Container(6209).NumItems,2)">Conditional</animation>

                    <include content="OSD_Stream_Selector_BackgroundResizer">
                        <param name="id">6209</param>
                        <param name="diffuse_w">720</param>
                    </include>

                    <include content="Object_MenuHeader">
                        <param name="label">$LOCALIZE[559]</param>
                        <param name="icon">special://skin/extras/icons/playlist.png</param>
                    </include>

                    <control type="panel" id="6209">
                        <top>140</top>
                        <bottom>40</bottom>
                        <ondown>SetFocus(6209,0,absolute)</ondown>
                        <onup>SetFocus(6209,9999,absolute)</onup>
                        <onleft>Close</onleft>
                        <onleft>SetFocus(6005,0,absolute)</onleft>
                        <onright>Close</onright>
                        <onright>SetFocus(6010,0,absolute)</onright>
                        <pagecontrol>6309</pagecontrol>
                        <orientation>vertical</orientation>
                        <scrolltime tween="quadratic">400</scrolltime>
                        <preloaditems>2</preloaditems>
                        <content>playlistmusic://</content>

                        <onclick>SetProperty(nc_play_offset,$INFO[Container(6209).CurrentItem],Home)</onclick>
                        <onclick>RunPlugin(plugin://$VAR[Action_MusicOSD_CommentPlugin]/play_playlist_offset/)</onclick>

                        <itemlayout height="80">
                            <control type="group">
                                <width>680</width>
                                <height>80</height>
                                <control type="group">
                                    <centertop>50%</centertop>
                                    <width>56</width>
                                    <height>56</height>
                                    <control type="image">
                                        <texture colordiffuse="main_fg_12">diffuse/circle/circle_50.png</texture>
                                        <aspectratio scalediffuse="false">scale</aspectratio>
                                    </control>
                                    <control type="image">
                                        <texture diffuse="diffuse/circle/circle_50.png" colordiffuse="white" fallback="DefaultAudio.png" background="true">$INFO[ListItem.Art(thumb)]</texture>
                                        <aspectratio scalediffuse="false">scale</aspectratio>
                                        <bordersize>2</bordersize>
                                        <bordertexture colordiffuse="main_fg_100">common/circle.png</bordertexture>
                                    </control>
                                </control>
                                <control type="label">
                                    <left>70</left>
                                    <right>10</right>
                                    <top>14</top>
                                    <height>26</height>
                                    <aligny>center</aligny>
                                    <font>font_mini_bold</font>
                                    <textcolor>main_fg_90</textcolor>
                                    <label>$INFO[ListItem.Title]</label>
                                    <scroll>false</scroll>
                                </control>
                                <control type="label">
                                    <left>70</left>
                                    <right>10</right>
                                    <top>42</top>
                                    <height>22</height>
                                    <aligny>center</aligny>
                                    <font>font_tiny</font>
                                    <textcolor>main_fg_70</textcolor>
                                    <label>$INFO[ListItem.Artist]$INFO[ListItem.Duration, • ,]</label>
                                    <scroll>false</scroll>
                                </control>
                            </control>
                        </itemlayout>

                        <focusedlayout height="80">
                            <control type="group">
                                <width>680</width>
                                <height>80</height>
                                <control type="image">
                                    <texture colordiffuse="main_fg_12" border="20">common/box.png</texture>
                                    <visible>!ListItem.IsPlaying</visible>
                                </control>
                                <control type="image">
                                    <texture colordiffuse="$VAR[ColorHighlight]" border="20">common/box.png</texture>
                                    <visible>Control.HasFocus(6209)</visible>
                                </control>
                                <control type="image">
                                    <texture border="20" colordiffuse="main_fg_30">common/box.png</texture>
                                    <visible>ListItem.IsPlaying + !Control.HasFocus(6209)</visible>
                                </control>
                                <control type="group">
                                    <centertop>50%</centertop>
                                    <width>56</width>
                                    <height>56</height>
                                    <control type="image">
                                        <texture colordiffuse="main_fg_12">diffuse/circle/circle_50.png</texture>
                                        <aspectratio scalediffuse="false">scale</aspectratio>
                                    </control>
                                    <control type="image">
                                        <texture diffuse="diffuse/circle/circle_50.png" colordiffuse="white" fallback="DefaultAudio.png" background="true">$INFO[ListItem.Art(thumb)]</texture>
                                        <aspectratio scalediffuse="false">scale</aspectratio>
                                        <bordersize>2</bordersize>
                                        <bordertexture colordiffuse="$VAR[ColorHighlight]">common/circle.png</bordertexture>
                                        <visible>Control.HasFocus(6209)</visible>
                                    </control>
                                    <control type="image">
                                        <texture diffuse="diffuse/circle/circle_50.png" colordiffuse="white" fallback="DefaultAudio.png" background="true">$INFO[ListItem.Art(thumb)]</texture>
                                        <aspectratio scalediffuse="false">scale</aspectratio>
                                        <bordersize>2</bordersize>
                                        <bordertexture colordiffuse="main_fg_100">common/circle.png</bordertexture>
                                        <visible>!Control.HasFocus(6209)</visible>
                                    </control>
                                </control>
                                <control type="label">
                                    <left>70</left>
                                    <right>10</right>
                                    <top>14</top>
                                    <height>26</height>
                                    <aligny>center</aligny>
                                    <font>font_mini_bold</font>
                                    <textcolor>main_fg_100</textcolor>
                                    <label>$INFO[ListItem.Title]</label>
                                    <scroll>true</scroll>
                                </control>
                                <control type="label">
                                    <left>70</left>
                                    <right>10</right>
                                    <top>42</top>
                                    <height>22</height>
                                    <aligny>center</aligny>
                                    <font>font_tiny</font>
                                    <textcolor>main_fg_80</textcolor>
                                    <label>$INFO[ListItem.Artist]$INFO[ListItem.Duration, • ,]</label>
                                    <scroll>true</scroll>
                                </control>
                            </control>
                        </focusedlayout>
                    </control>
                </control>

                <include content="Part_Scrollbar_Max">
                    <param name="id">6309</param>
                    <top>120</top>
                    <bottom>40</bottom>
                    <onleft>6209</onleft>
                    <onright>Close</onright>
                    <onright>SetFocus(6009,0,absolute)</onright>
                </include>

            </control>
        </control>

    </controls>
</window>