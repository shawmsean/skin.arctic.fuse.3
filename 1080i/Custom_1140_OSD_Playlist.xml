<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1140">
    <zorder>0</zorder>
    <defaultcontrol always="true">7000</defaultcontrol>
    <onload>CancelAlarm(osd_timeout,true)</onload>
    <onload>CancelAlarm(musicosd_showlyrics,true)</onload>
    <!-- 音乐模式：打开播放列表时，插件端延迟2秒后获取位置并SetFocus到当前播放项 -->
    <onload condition="Window.IsActive(musicosd)">RunPlugin(plugin://$VAR[Action_MusicOSD_CommentPlugin]/playlist_focus_current/)</onload>
    <include>Animation_OSD_Dialog_WindowChange</include>
    <controls>

        <!-- 全屏半透明遮罩背景（音乐模式下虚化效果） -->
        <control type="image">
            <visible>!Skin.HasSetting(MusicOSD.CommentsDimBg)</visible>
            <visible>Window.IsActive(musicosd)</visible>
            <texture colordiffuse="B2000000">common/white.png</texture>
            <animation effect="fade" start="0" end="100" time="200">Visible</animation>
            <animation effect="fade" start="100" end="0" time="150">Hidden</animation>
        </control>

        <control type="group">
            <visible>!Window.IsActive(pvrchannelguide)</visible>
            <visible>!Window.IsActive(pvrosdchannels)</visible>
            <visible>!Window.IsActive(videobookmarks)</visible>
            <visible>!Window.IsActive(1141)</visible>

            <include>Animation_OSD_Dialog_VisibleChange</include>
            <control type="group">
                <include>OSD_Info_Dimensions</include>

                <include content="OSD_View_Line">
                    <param name="label">$LOCALIZE[559]</param>
                </include>

                <!-- Music Playlist (Square) -->
                <include content="List_Square_Row" condition="Window.IsActive(musicosd)">
                    <param name="orientation">horizontal</param>
                    <param name="control">fixedlist</param>
                    <param name="id">7000</param>
                    <include content="Object_ContentDynamic">
                        <param name="content">playlistmusic://</param>
                    </include>
                    <include>OSD_List_Dimensions</include>
                    <onclick condition="Window.IsActive(musicosd)">SetProperty(nc_play_offset,$INFO[Container(7000).CurrentItem],Home)</onclick>
                    <onclick condition="Window.IsActive(musicosd)">RunPlugin(plugin://$VAR[Action_MusicOSD_CommentPlugin]/play_playlist_offset/)</onclick>
                    <onup condition="!Skin.HasSetting(MusicOSD.OnDown.Disable1142)">SetProperty(bili_comment_content_url,plugin://$VAR[Action_MusicOSD_CommentPlugin]/current_song_comments/0,10000)</onup>
                    <onup condition="!Skin.HasSetting(MusicOSD.OnDown.Disable1142)">Close</onup>
                    <onup condition="!Skin.HasSetting(MusicOSD.OnDown.Disable1142)">AlarmClock(musicosd_nav,ActivateWindow(1142),00:00,silent)</onup>
                    <onup>Close</onup>
                    <ondown>Close</ondown>
                    <ondown>AlarmClock(musicosd_nav,ActivateWindow($VAR[Action_MusicOSD_1140_OnDown]),00:00,silent)</ondown>
                    <onfocus>SetProperty(TMDbHelper.WidgetContainer,7000,1140)</onfocus>
                    <onunfocus>ClearProperty(TMDbHelper.WidgetContainer,1140)</onunfocus>
                    <include content="Animation_ConditionalFade">
                        <param name="condition">Container(7000).IsUpdating</param>
                    </include>
                </include>

                <!-- Episodes List (Landscape) -->
                <include content="List_Landscape_Row" condition="!Window.IsActive(musicosd)">
                    <param name="orientation">horizontal</param>
                    <param name="control">fixedlist</param>
                    <param name="id">7000</param>
                    <include content="Object_ContentDynamic" condition="VideoPlayer.Content(livetv)">
                        <param name="sortby">lastplayed</param>
                        <param name="sortorder">descending</param>
                        <param name="content">pvr://channels/tv/*</param>
                    </include>
                    <include content="Object_ContentDynamic" condition="!VideoPlayer.Content(livetv)">
                        <param name="content">$VAR[Path_OSD_Episodes]</param>
                    </include>
                    <include>OSD_List_Dimensions</include>
                    <onup>Close</onup>
                    <ondown>ActivateWindow($VAR[Action_OSD_1140_OnDown])</ondown>
                    <onfocus>SetProperty(TMDbHelper.WidgetContainer,7000,1140)</onfocus>
                    <onunfocus>ClearProperty(TMDbHelper.WidgetContainer,1140)</onunfocus>
                    <include content="Animation_ConditionalFade">
                        <param name="condition">Container(7000).IsUpdating</param>
                    </include>
                </include>

                <!-- Playing Icon and Details -->
                <include content="OSD_Info_Tray">
                    <param name="icon">$VAR[Image_OSD_7000_Poster]</param>
                    <param name="role">$VAR[Label_OSD_7000_Title]</param>
                    <param name="name">$VAR[Label_OSD_7000_SubLabel]</param>
                    <param name="text">$INFO[Container(7000).ListItem..Plot]</param>
                </include>

                <include content="Widget_Busy">
                    <param name="label">$PARAM[label]</param>
                    <param name="visible">Container(7000).IsUpdating</param>
                    <param name="include">List_Landscape_Row</param>
                    <left>view_pad</left>
                    <top>-150</top>
                </include>

            </control>
        </control>
    </controls>
</window>
